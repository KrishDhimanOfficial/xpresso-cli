{
  "name": "backend",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file=.env.production ./bin/www",
    "dev": "NODE_ENV=development concurrently -k -n env,server -c blue,green \"node scripts/sync-env.js\" \"nodemon --ignore config/config.js ./bin/www\"",
    "sync-env": "NODE_ENV=development node scripts/sync-env.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.14"
  }
}
